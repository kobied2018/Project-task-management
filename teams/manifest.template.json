    }
  ],
  "validDomains": [
    "__TEAMS_DOMAIN__",
    "login.microsoftonline.com"
  ],
  "webApplicationInfo": {
    "id": "__ENTRA_CLIENT_ID__",
    "resource": "__ENTRA_APP_ID_URI__"
  }
}