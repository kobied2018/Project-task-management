{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "__TEAMS_APP_ID__",
  "packageName": "com.fieldnotes.projectworkspace",
  "developer": {
    "name": "Fieldnotes",
    "websiteUrl": "https://__TEAMS_DOMAIN__",
    "privacyUrl": "https://__TEAMS_DOMAIN__/privacy",
    "termsOfUseUrl": "https://__TEAMS_DOMAIN__/terms",
    "mpnId": "00000000-0000-0000-0000-000000000000"
  },
  "name": {
    "short": "Fieldnotes",
    "full": "Fieldnotes Project Workspace"
  },
