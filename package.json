{
  "name": "fieldnotes-teams-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "package:teams": "node scripts/package-teams.mjs",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@microsoft/teams-js": "^2.37.0",
    "archiver": "^7.0.1",
    "docx": "^9.15.3",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "pngjs": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2",
    "vite": "^6.3.5"
  }
}
